{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Explicit real rectangular boundary endpoint",
  "oneOf": [
    {
      "type": "string",
      "description": "Legacy real node ID; four midpoint ports only"
    },
    {
      "type": "null",
      "description": "Existing real path junction semantics unchanged"
    },
    {
      "type": "object",
      "required": [
        "node",
        "side",
        "fraction"
      ],
      "properties": {
        "node": {
          "type": "string",
          "minLength": 1
        },
        "side": {
          "enum": [
            "left",
            "right",
            "top",
            "bottom"
          ]
        },
        "fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "asset",
        "side",
        "fraction"
      ],
      "properties": {
        "asset": {
          "type": "string",
          "minLength": 1
        },
        "side": {
          "enum": [
            "left",
            "right",
            "top",
            "bottom"
          ]
        },
        "fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "path",
        "side",
        "fraction"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "side": {
          "enum": [
            "left",
            "right",
            "top",
            "bottom"
          ]
        },
        "fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    }
  ]
}